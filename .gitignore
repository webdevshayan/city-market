# --- Secrets & environment (never commit) ---
.env
.env.*
*.token
*.pem
*.key

# --- Dependencies ---
node_modules/

# --- Go build outputs ---
server/bin/
*.test

# --- Flutter / Dart build outputs (added per-app when SDK work starts) ---
apps/*/build/
apps/*/.dart_tool/
apps/*/ios/Pods/
apps/*/.flutter-plugins*
apps/*/.packages

# server/static/styles.css IS committed on purpose (single minified stylesheet, no CDN).

# --- Local agent workspace (not part of the product repo) ---
download/
upload/
skills/
.tools/
.secrets/

# --- Misc ---
*.log
.DS_Store

# --- Flutter ---
apps/*/build/

# --- Android release signing (lives in Actions secrets, never in git) ---
*.p12
*.jks
apps/*/android/keystore.properties
apps/*/android/app/release-keystore.p12
